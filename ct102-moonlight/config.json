{
  "data_storage": {
    "type": "json",
    "path": "server/data.json",
    "session_expiration_check_interval": { "secs": 300, "nanos": 0 }
  },
  "webrtc": {
    "ice_servers": [
      {
        "urls": [
          "stun:stun.l.google.com:19302",
          "stun:stun1.l.google.com:3478"
        ],
        "username": "",
        "credential": ""
      }
    ],
    "ice_server_script": null,
    "port_range": { "min": 40000, "max": 40010 },
    "nat_1to1": { "ice_candidate_type": "host", "ips": ["192.0.2.75"] },
    "include_loopback_candidates": true
  },
  "web_server": {
    "bind_address": "0.0.0.0:8080",
    "certificate": null,
    "url_path_prefix": "",
    "session_cookie_secure": true,
    "session_cookie_expiration": { "secs": 86400, "nanos": 0 },
    "first_login_create_admin": true,
    "first_login_assign_global_hosts": true,
    "forwarded_header": {
      "username_header": "X-authentik-username",
      "auto_create_missing_user": true,
      "ignore_case": true
    }
  },
  "moonlight": {
    "default_http_port": 47989,
    "pair_device_name": "home-web"
  },
  "log": {
    "level_filter": "INFO",
    "file_path": null,
    "dev_venator": false
  }
}
